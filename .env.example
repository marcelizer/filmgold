# Filmgold – lokale Konfiguration
# Kopiere diese Datei nach .env.local und trage deine Werte ein.

# TMDB Read Access Token (v4) – empfohlen
TMDB_ACCESS_TOKEN=

# Oder alternativ der TMDB API Key (v3) – ein Key genügt
TMDB_API_KEY=

# Basis-URL für Open-Graph-/Twitter-Bilder (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Abweichender Speicherort für Datenbank und Bild-Cache (optional)
# Standard: data/filmgold.db und data/media
# DATABASE_PATH=
# MEDIA_PATH=
